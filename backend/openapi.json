          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Cash Forecast",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/invoice/{invoice_id}": {
      "get": {
        "description": "Full investigation detail for one invoice (FR-003, FR-007, FR-014).",
        "operationId": "investigation_api_invoice__invoice_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "invoice_id",
            "required": true,
            "schema": {
              "title": "Invoice Id",
              "type": "string"
