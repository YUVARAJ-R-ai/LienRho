                "schema": {
                  "$ref": "#/components/schemas/InvestigationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Investigation",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/invoice/{invoice_id}/artifact": {
      "get": {
        "description": "Re-fetch the artifact an approved action produced (FR-011/012/013).\n\nWithout this, an approved dossier would exist only in the browser tab that\napproved it and vanish on reload \u2014 which is exactly the wrong property for a\ndocument someone intends to file.\n\nStill gated: `build_artifact` raises `ApprovalRequired` for anything not\napproved, so this is a way to re-read a decision, not to bypass one.",
        "operationId": "invoice_artifact_api_invoice__invoice_id__artifact_get",
        "parameters": [
          {
            "in": "path",
            "name": "invoice_id",
            "required": true,
            "schema": {
              "title": "Invoice Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Invoice Artifact",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/invoice/{invoice_id}/draft": {
      "get": {
        "description": "Draft a reminder for one invoice (FR-011).\n\nNot gated on approval \u2014 the draft is what the user reads in order to decide.\nSending it is their own action in their own client (OQ-01).",
        "operationId": "invoice_draft_api_invoice__invoice_id__draft_get",
        "parameters": [
          {
            "in": "path",
