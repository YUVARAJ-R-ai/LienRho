  "info": {
    "title": "LIENRHO API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/action-queue": {
      "get": {
        "description": "The prioritized daily action queue (FR-009).",
        "operationId": "action_queue_api_action_queue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ActionQueueItemOut"
                  },
                  "title": "Response Action Queue Api Action Queue Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Action Queue",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/actions/{invoice_id}/approve": {
      "post": {
        "description": "Approve a recommendation and generate what it produces (FR-010, FR-012, FR-013).\n\n`actor` comes from the verified token, never from the request. FR-014 asks\nwho decided; a caller-supplied name would let anyone sign the audit trail\nwith somebody else's identity, which is the one thing that record exists to\nprevent.",
        "operationId": "approve_action_api_actions__invoice_id__approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "invoice_id",
            "required": true,
            "schema": {
              "title": "Invoice Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResultOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Approve Action",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/actions/{invoice_id}/reject": {
      "post": {
        "description": "Reject a recommendation. Invoice state is left unchanged (FR-010 AC-2).",
        "operationId": "reject_action_api_actions__invoice_id__reject_post",
        "parameters": [
          {
            "in": "path",
            "name": "invoice_id",
            "required": true,
            "schema": {
              "title": "Invoice Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResultOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Reject Action",
        "tags": [
          "lienrho"
        ]
      }
    },
    "/api/forecast": {
      "get": {
        "description": "30-day rolling cash forecast with shortfall contributors (FR-004, FR-015).",
        "operationId": "cash_forecast_api_forecast_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashForecastOut"
